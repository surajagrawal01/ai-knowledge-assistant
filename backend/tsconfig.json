{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true, // catches null/undefined bugs; non-negotiable
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "exclude": [
    "prisma.config.ts",
    "prisma.config.js"
  ]
}